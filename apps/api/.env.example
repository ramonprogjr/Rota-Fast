# Rota Max API — copie para .env e preencha. NUNCA commite o .env.

# Conexão usada pela API em execução (pooler do Supabase, modo transaction, porta 6543).
# pgbouncer=true desliga prepared statements no Prisma; connection_limit baixo no plano Free.
DATABASE_URL="postgresql://postgres.<project-ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3"

# Conexão direta (porta 5432), usada só por `prisma migrate deploy`.
DIRECT_URL="postgresql://postgres.<project-ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# URL do projeto Supabase. A API busca as chaves públicas em
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json e confere iss = ${SUPABASE_URL}/auth/v1.
SUPABASE_URL="https://<project-ref>.supabase.co"

# Audience dos tokens de usuário do Supabase Auth.
SUPABASE_JWT_AUDIENCE="authenticated"

PORT=3000

# Origens liberadas no CORS (separadas por vírgula). Vazio = nenhuma (o app Android não precisa).
CORS_ORIGINS=""

# Requisições por minuto por cliente (rate limit global).
RATE_LIMIT_PER_MINUTE=120
